---
interface Props {
  title: string;
  description?: string;
}

import Header from "../components/Header.astro";

const {
  title,
  description = "Type-safe TypeScript hooks for all 30 Claude Code events, with matcher-aware tool inputs and generated runtime wrappers.",
} = Astro.props;
const base = `${import.meta.env.BASE_URL}/`;
const canonicalPath = `${Astro.url.pathname.replace(/\/$/, "")}/`;
const canonical = new URL(canonicalPath, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <slot />
  </body>
</html>

<style is:global>
  @import "../styles/global.css";

  .skip-link {
    position: fixed;
    top: 0;
    left: 1rem;
    z-index: 100;
    padding: 0.6rem 0.9rem;
    color: var(--color-bg);
    background: var(--color-amber);
    transform: translateY(-120%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }
</style>
