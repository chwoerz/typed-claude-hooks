{
  "name": "typed-claude-hooks",
  "version": "0.1.0",
  "description": "Type-safe Claude Code hooks in TypeScript",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "typed-claude-hooks": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.ts",
      "default": "./dist/compiler/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "test": "vitest run && npm run test:package",
    "test:package": "npm run build && node scripts/test-package-exports.mjs",
    "test:watch": "vitest",
    "extract-types": "tsx scripts/extract-types.ts",
    "format": "biome format --write src/ tests/",
    "lint": "biome lint src/ tests/",
    "check": "biome check src/ tests/",
    "prepublishOnly": "npm run build",
    "release": "np --dry-run"
  },
  "keywords": [
    "claude",
    "hooks",
    "typescript",
    "claude-code"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^13.0.0",
    "esbuild": "^0.25.0",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.0",
    "@biomejs/biome": "2.5.1",
    "@types/node": "^22",
    "np": "^11.2.1",
    "prettier": "^3.8.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
